# Normalise line endings to LF in the repository, so that a Windows checkout plus
# Prettier does not produce CRLF-only diffs.
* text=auto eol=lf

*.png binary
*.jpg binary
*.sqlite binary

# Sent verbatim as a request body, and HTTP multipart requires CRLF - the server answers 400 for LF.
# The normalisation above would silently turn this into a failing test on checkout.
test/batch-multipart.txt -text
