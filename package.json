{
  "name": "test-server-cap",
  "version": "0.4.1",
  "private": true,
  "description": "SAP CAP implementation of the odata2ts OData V4 server feature test model \"Library\"",
  "homepage": "https://github.com/odata2ts/test-server-cap",
  "repository": "git@github.com:odata2ts/test-server-cap.git",
  "license": "MIT",
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "scripts": {
    "build": "cds build",
    "deploy": "cds deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:requests": "node test/harness/lint.js",
    "metadata": "cds compile srv --to edmx --dest gen/edmx",
    "start": "cds watch",
    "test": "npm run lint:requests && node test/harness/run.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.16.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10.0.3"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.19.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@sap/cds-dk": "^10",
    "@types/node": "^24.0.0",
    "httpyac": "6.16.7",
    "prettier": "^3.3.3",
    "prettier-plugin-packagejson": "^3.0.0",
    "tsx": "^4",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  }
}
